@page
@model LoginModel

@{
    ViewData["Title"] = "Customer & Staff Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="p-4 p-md-5 rounded-3 bg-white border shadow-sm">
                <div class="text-center mb-4">
                    <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.05em;">Apex Account Access</span>
                    <h2 class="fw-bold mb-1">Welcome Back</h2>
                    <p class="text-muted small">Sign in to manage your vehicle reservations and profile.</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="apex-form-label">Email Address</label>
                        <input asp-for="Input.Email" class="apex-form-control" autocomplete="username" aria-required="true" placeholder="name@example.co.nz" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="apex-form-label">Password</label>
                        <input asp-for="Input.Password" class="apex-form-control" autocomplete="current-password" aria-required="true" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                            <label class="form-check-label small text-secondary" for="rememberMe">Remember me</label>
                        </div>
                    </div>

                    <button id="login-submit" type="submit" class="btn-brand w-100 py-3" style="font-size: 1rem;">
                        Sign In &rarr;
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-muted">
                    Don't have an account yet? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold">Create account</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
