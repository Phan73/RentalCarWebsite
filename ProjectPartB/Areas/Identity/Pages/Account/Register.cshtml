@page
@model RegisterModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="p-4 p-md-5 rounded-3 bg-white border shadow-sm">
                <div class="text-center mb-4">
                    <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.05em;">Join Apex Car Rentals</span>
                    <h2 class="fw-bold mb-1">Create Customer Account</h2>
                    <p class="text-muted small">Enjoy faster bookings, exclusive duration discounts, and self-service reservation management.</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.FullName" class="apex-form-label">Full Legal Name *</label>
                            <input asp-for="Input.FullName" class="apex-form-control" placeholder="e.g. Emma Walker" required />
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="apex-form-label">Email Address *</label>
                            <input asp-for="Input.Email" class="apex-form-control" type="email" placeholder="name@example.co.nz" required />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Phone" class="apex-form-label">Phone Contact *</label>
                            <input asp-for="Input.Phone" class="apex-form-control" type="tel" placeholder="+64 21 555 7890" required />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.Address" class="apex-form-label">Residential Address *</label>
                            <input asp-for="Input.Address" class="apex-form-control" placeholder="Street address, Suburb, City" required />
                            <span asp-validation-for="Input.Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.DrivingLicense" class="apex-form-label">Driver's Licence Number *</label>
                            <input asp-for="Input.DrivingLicense" class="apex-form-control" placeholder="e.g. NZL-882910" required />
                            <span asp-validation-for="Input.DrivingLicense" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="apex-form-label">Password *</label>
                            <input asp-for="Input.Password" class="apex-form-control" type="password" required />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="apex-form-label">Confirm Password *</label>
                            <input asp-for="Input.ConfirmPassword" class="apex-form-control" type="password" required />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn-brand w-100 py-3 mt-4" style="font-size: 1rem;">
                        Create Account &rarr;
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-muted">
                    Already registered? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold">Sign in here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
