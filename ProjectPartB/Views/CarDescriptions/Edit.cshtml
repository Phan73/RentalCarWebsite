@model ProjectPartB.Models.CarDescription
@{
    ViewData["Title"] = $"Edit — {Model.Brand} {Model.Model}";
}

<div class="container py-5">
    <div class="max-w-2xl mx-auto">
        <div class="p-4 p-md-5 rounded-3 bg-white border shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.05em;">Fleet Operations</span>
                    <h2 class="fw-bold mb-0">Edit @Model.Brand @Model.Model</h2>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CarDescriptionId" />
                <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="Brand">Make / Brand *</label>
                        <input class="apex-form-control" asp-for="Brand" required />
                        <span asp-validation-for="Brand" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="Model">Model *</label>
                        <input class="apex-form-control" asp-for="Model" required />
                        <span asp-validation-for="Model" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="CarTypeId">Category *</label>
                        <select class="apex-form-control" asp-for="CarTypeId" asp-items="ViewBag.CarTypeId"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="RatePerDay">Daily Rate (NZD) *</label>
                        <input class="apex-form-control" asp-for="RatePerDay" type="number" step="0.01" min="1" required />
                        <span asp-validation-for="RatePerDay" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="Transmission">Transmission *</label>
                        <select class="apex-form-control" asp-for="Transmission">
                            <option value="Automatic">Automatic</option>
                            <option value="Manual">Manual</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="FuelType">Fuel / Powertrain *</label>
                        <select class="apex-form-control" asp-for="FuelType">
                            <option value="Petrol">Petrol</option>
                            <option value="Diesel">Diesel</option>
                            <option value="Hybrid">Hybrid</option>
                            <option value="Electric">Electric</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="apex-form-label" asp-for="Seats">Seats *</label>
                        <input class="apex-form-control" asp-for="Seats" type="number" min="2" max="12" required />
                    </div>

                    <div class="col-md-4">
                        <label class="apex-form-label" asp-for="Luggage">Luggage Capacity *</label>
                        <input class="apex-form-control" asp-for="Luggage" type="number" min="0" max="10" required />
                    </div>

                    <div class="col-md-4">
                        <label class="apex-form-label" asp-for="Year">Model Year *</label>
                        <input class="apex-form-control" asp-for="Year" type="number" min="2000" max="2030" required />
                    </div>

                    <div class="col-md-6">
                        <label class="apex-form-label" asp-for="Color">Exterior Color *</label>
                        <input class="apex-form-control" asp-for="Color" required />
                        <span asp-validation-for="Color" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="apex-form-label">Vehicle Photo & Imagery</label>
                        <div class="d-flex flex-column flex-md-row align-items-md-center gap-3 p-3 bg-light rounded border mb-2">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                var currentImg = (Model.Image.StartsWith("http") || Model.Image.StartsWith("data:")) ? Model.Image : Url.Content("~/uploads/" + Model.Image);
                                <img src="@currentImg" alt="@Model.Brand @Model.Model" class="rounded object-fit-cover border shadow-sm" style="width: 140px; height: 90px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="width: 140px; height: 90px;">No Photo</div>
                            }
                            <div class="flex-grow-1">
                                <label class="apex-form-label mb-1" for="imageFile">Upload New Photo File (JPG, PNG, WEBP)</label>
                                <input class="apex-form-control mb-2" id="imageFile" name="imageFile" type="file" accept=".jpg,.jpeg,.png,.webp" />
                                <label class="apex-form-label mb-1" asp-for="Image">Or Photo URL (Web Link)</label>
                                <input class="apex-form-control" asp-for="Image" placeholder="https://images.unsplash.com/... or keep current" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="apex-form-label" asp-for="Description">Vehicle Description *</label>
                        <textarea class="apex-form-control" asp-for="Description" rows="3" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check mt-2">
                            <input class="form-check-input" asp-for="Featured" id="featuredCheck" />
                            <label class="form-check-label small" for="featuredCheck">Feature on Homepage</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check mt-2">
                            <input class="form-check-input" asp-for="Available" id="availCheck" />
                            <label class="form-check-label small" for="availCheck">Available for Booking</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    <button type="submit" class="btn-brand">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
