@model ProjectPartB.Models.CarType
@{
    ViewData["Title"] = "Add Vehicle Category";
}

<div class="container py-5">
    <div class="max-w-xl mx-auto">
        <div class="p-4 p-md-5 rounded-3 bg-white border shadow-sm">
            <h3 class="fw-bold mb-3">Add Category</h3>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label class="apex-form-label" asp-for="Name">Category Name *</label>
                    <input class="apex-form-control" asp-for="Name" required placeholder="e.g. Electric & Hybrid" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="apex-form-label" asp-for="Description">Description</label>
                    <textarea class="apex-form-control" asp-for="Description" rows="3" placeholder="Category highlights and typical use case..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-brand">Save Category</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
