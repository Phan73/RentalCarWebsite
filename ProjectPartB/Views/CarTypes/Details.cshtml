@model ProjectPartB.Models.CarType
@{
    ViewData["Title"] = $"Category Details — {Model.Name}";
}

<div class="container py-5">
    <div class="max-w-xl mx-auto">
        <div class="p-4 p-md-5 rounded-3 bg-white border shadow-sm">
            <h3 class="fw-bold mb-1">@Model.Name</h3>
            <p class="text-secondary small mb-4">@(Model.Description ?? "No description provided.")</p>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-brand">Edit Category</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
