@model IEnumerable<ProjectPartB.Models.CarType>
@{
    ViewData["Title"] = "Vehicle Categories";
}

<div class="py-4 bg-white border-bottom mb-4">
    <div class="container-fluid px-lg-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.05em;">Fleet Hierarchy</span>
                <h1 class="h2 fw-bold mb-0">Vehicle Categories</h1>
            </div>
            <a asp-action="Create" class="btn-brand">Add Category</a>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-4 pb-5">
    <div class="p-4 rounded-3 bg-white border shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light small">
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold fs-6">@item.Name</td>
                            <td class="text-secondary">@(item.Description ?? "Standard fleet classification")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
