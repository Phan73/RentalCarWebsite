@{
    ViewData["Title"] = "About Apex Car Rentals — Company Background & Standards";
}

<section class="py-5 bg-white border-bottom">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.05em;">Pure New Zealand Hospitality</span>
                <h1 class="display-5 fw-bold mb-3">Connecting Travelers with the Wonder of Aotearoa</h1>
                <p class="lead text-secondary">
                    Founded in New Zealand, Apex Car Rentals provides dependable, premium automotive rentals designed specifically for travelers exploring the diverse terrains of our country.
                </p>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <h3 class="fw-bold mb-3">Our Standards of Excellence</h3>
            <p>
                Whether you are driving the winding coastal highways of the Coromandel, traversing the dramatic Southern Alps between Christchurch and Queenstown, or visiting family across Auckland, our modern fleet delivers safety, comfort, and performance.
            </p>
            <p>
                Every vehicle in our fleet undergoes a comprehensive 40-point safety and cleanliness inspection prior to handover. We maintain direct relationships with major automotive manufacturers to ensure our guests drive late-model, fuel-efficient, and low-emission vehicles equipped with the latest driver assistance technologies.
            </p>

            <h4 class="fw-bold mt-4 mb-3">New Zealand Driving Guidance</h4>
            <div class="p-4 rounded-3" style="background: var(--surface-canvas); border: 1.5px solid var(--border-subtle);">
                <ul class="mb-0 text-secondary small d-flex flex-column gap-2">
                    <li><strong>Drive on the Left:</strong> Always remember to stay on the left-hand side of the road in New Zealand.</li>
                    <li><strong>Travel Times:</strong> Mountain roads and winding rural routes often take longer than GPS navigation estimates. Plan regular breaks.</li>
                    <li><strong>Single Lane Bridges:</strong> Pay close attention to red and white directional arrows on single-lane bridges indicating who has right-of-way.</li>
                    <li><strong>Strict Zero Tolerance:</strong> Strict drink-driving limits and mobile phone restrictions apply nationwide.</li>
                </ul>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="p-4 rounded-3 bg-white" style="border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
                <h5 class="fw-bold mb-3">Company Information</h5>
                <dl class="row small mb-0">
                    <dt class="col-5 text-muted">Registered Name:</dt>
                    <dd class="col-7">Apex Car Rentals Ltd</dd>

                    <dt class="col-5 text-muted">NZBN:</dt>
                    <dd class="col-7">9429038291024</dd>

                    <dt class="col-5 text-muted">Auckland Desk:</dt>
                    <dd class="col-7">152 Hobson Street</dd>

                    <dt class="col-5 text-muted">Support Line:</dt>
                    <dd class="col-7">+64 9 300 1234</dd>

                    <dt class="col-5 text-muted">Operating Hours:</dt>
                    <dd class="col-7">7:00 AM – 9:00 PM (7 Days)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
