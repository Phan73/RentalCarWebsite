@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong — Apex Car Rentals";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 text-center">
            <div class="p-5 rounded-4 bg-white border shadow-sm">
                <div class="mb-4 d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: rgba(220, 53, 69, 0.1);">
                    <svg width="36" height="36" fill="none" stroke="var(--accent-red, #dc3545)" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>

                <h1 class="h3 fw-bold mb-2">We Encountered an Unexpected Issue</h1>
                <p class="text-muted mb-4" style="max-width: 520px; margin: 0 auto;">
                    An error occurred while processing your request. Our engineering team has been notified, and our support desk is ready to assist with your booking.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="p-3 mb-4 rounded-3 text-start" style="background: #f8f9fa; border: 1px dashed #dee2e6;">
                        <div class="small text-muted fw-semibold mb-1">Diagnostic Reference</div>
                        <code class="user-select-all small text-dark font-monospace d-block text-break">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <a asp-controller="CarDescriptions" asp-action="Index" class="btn-brand px-4 py-2 text-decoration-none">
                        Browse Available Vehicles
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        Return to Homepage
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-link text-decoration-none text-muted">
                        Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
