@using Microsoft.AspNetCore.Identity
@using ProjectPartB.Areas.Identity.Data
@inject SignInManager<WebUser> SignInManager
@inject UserManager<WebUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Apex Car Rentals New Zealand</title>
    
    <!-- Typography: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Framework & Custom Design Tokens -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg apex-navbar">
            <div class="container-fluid px-lg-4">
                <a class="apex-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="apex-brand-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4.66l.12-.34h13.77l.11.34V17z"/>
                        <circle cx="7.5" cy="14.5" r="1.5"/>
                        <circle cx="16.5" cy="14.5" r="1.5"/>
                    </svg>
                    <span>APEX <span style="color: var(--brand-teal-400); font-weight: 400;">RENTALS</span></span>
                </a>

                <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#apexNavContent" aria-controls="apexNavContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="apexNavContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="apex-nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="apex-nav-link" asp-controller="CarDescriptions" asp-action="Index">Vehicle Fleet</a>
                        </li>
                        <li class="nav-item">
                            <a class="apex-nav-link" asp-controller="Home" asp-action="About">Why Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="apex-nav-link" asp-controller="Home" asp-action="Contact">Locations & Support</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="apex-nav-link" asp-controller="Booking" asp-action="MyBookings">
                                    My Reservations
                                </a>
                            </li>

                            @if (User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("Staff"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="apex-nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Operations
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Dashboard Overview</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Bookings">All Reservations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Fleet">Fleet Management</a></li>
                                        <li><a class="dropdown-item" asp-controller="CarTypes" asp-action="Index">Vehicle Categories</a></li>
                                        @if (User.IsInRole("Administrator"))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" asp-controller="UserRoles" asp-action="Users">User & Role Permissions</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var displayName = user?.FullName ?? UserManager.GetUserName(User);
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>@displayName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                                    <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">Booking History</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                            <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="apex-nav-link" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
                            <a class="btn-brand" asp-area="Identity" asp-page="/Account/Register">Create Account</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="apex-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <svg width="24" height="24" fill="var(--brand-teal-400)" viewBox="0 0 24 24">
                            <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4.66l.12-.34h13.77l.11.34V17z"/>
                        </svg>
                        <span class="text-white fw-bold fs-5">APEX CAR RENTALS</span>
                    </div>
                    <p class="text-secondary small">
                        New Zealand's trusted independent car rental service. Transparent daily rates, unlimited kilometers on all standard rentals, and seamless collection at major airports nationwide.
                    </p>
                    <div class="text-secondary small">
                        <strong>Headquarters:</strong> 152 Hobson Street, Auckland CBD, New Zealand<br />
                        <strong>Phone:</strong> +64 9 300 1234 &bull; <strong>Email:</strong> info@apexcarrentals.co.nz
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="apex-footer-heading">Fleet</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="CarDescriptions" asp-action="Index">All Vehicles</a></li>
                        <li><a asp-controller="CarDescriptions" asp-action="Index" asp-route-category="Sedan">Executive Sedans</a></li>
                        <li><a asp-controller="CarDescriptions" asp-action="Index" asp-route-category="SUV">Touring SUVs</a></li>
                        <li><a asp-controller="CarDescriptions" asp-action="Index" asp-route-fuel="Electric">Electric & Hybrid</a></li>
                        <li><a asp-controller="CarDescriptions" asp-action="Index" asp-route-category="Van">People Movers</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="apex-footer-heading">Branches</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Home" asp-action="Contact">Auckland Airport (AKL)</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Auckland Central CBD</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Wellington Airport (WLG)</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Christchurch Airport (CHC)</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Queenstown Airport (ZQN)</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="apex-footer-heading">Customer Assurance</h6>
                    <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255,255,255,0.08);">
                        <p class="small text-secondary mb-2">
                            <strong>Zero Hidden Fees:</strong> All rates include 15% New Zealand Goods and Services Tax (GST) and standard road risk cover.
                        </p>
                        <p class="small text-secondary mb-0">
                            <strong>Privacy Guaranteed:</strong> Customer and driver's licence data is securely processed in strict accordance with the New Zealand Privacy Act 2020.
                        </p>
                    </div>
                </div>
            </div>

            <div class="apex-footer-bottom">
                <div>
                    &copy; @DateTime.UtcNow.Year Apex Car Rentals Limited. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="About">Terms of Rental</a>
                    <a asp-controller="Home" asp-action="Contact">Customer Care</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
