@model ProjectPartB.Models.AssignRoleViewModel
@{
    ViewData["Title"] = "Assign Role to User";
}

<div class="container py-5">
    <div class="max-w-xl mx-auto">
        <div class="p-4 rounded-3 bg-white border shadow-sm">
            <h3 class="fw-bold mb-1">Reassign User Role</h3>
            <p class="text-muted small mb-4">Updating authorization level for user <strong>@Model.UserName</strong></p>

            <form asp-action="AssignRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserName" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-4">
                    <label class="apex-form-label" for="RoleId">Select Role</label>
                    <select class="apex-form-control" asp-for="RoleId" id="RoleId" required>
                        @if (Model.Roles != null)
                        {
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id" selected="@(Model.RoleName == role.Name)">@role.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-brand">Save Role Assignment</button>
                    <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
