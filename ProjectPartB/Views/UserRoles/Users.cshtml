@model List<ProjectPartB.Models.AssignRoleViewModel>
@{
    ViewData["Title"] = "User Role Administration";
}

<div class="py-4 bg-white border-bottom mb-4">
    <div class="container-fluid px-lg-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.05em;">Security & Access Control</span>
                <h1 class="h2 fw-bold mb-0">System Users & Roles</h1>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Manage System Roles</a>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-4 pb-5">
    <div class="p-4 rounded-3 bg-white border shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light small">
                    <tr>
                        <th>User ID</th>
                        <th>User Name / Email</th>
                        <th>Assigned Roles</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="font-monospace text-muted" style="font-size: 0.75rem;">@user.UserId</td>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(string.IsNullOrWhiteSpace(user.RoleName) ? "Customer (Default)" : user.RoleName)
                                </span>
                            </td>
                            <td>
                                <a asp-action="AssignRole" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-brand">
                                    Reassign Role
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
